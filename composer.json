{
    "name": "componist/core",
    "description": "Laravel dashboard core: layouts, menus, settings, notifications, Blade/Livewire UI primitives, and shared security helpers",
    "keywords": [
        "laravel",
        "livewire",
        "dashboard",
        "blade",
        "components",
        "menu",
        "notifications",
        "componist"
    ],
    "homepage": "https://componist.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Componist Developer",
            "email": "info@componist.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^4.0",
        "componist/reminder-notifications": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist"
    },
    "autoload": {
        "files": [
            "src/Helpers/helpers.php"
        ],
        "psr-4": {
            "Componist\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Componist\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
